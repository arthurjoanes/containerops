# Valores locais. Os scripts criam as credenciais demo.
COMPOSE_PROJECT_NAME=pf-containerops
# No Windows os scripts exigem exatamente esta pasta dentro do seu perfil; no Linux/CI, qualquer pasta com "containerops" no nome.
CONTAINEROPS_RUNTIME=C:/Users/SEU_USUARIO/AppData/Local/ContainerOps-runtime
APP_IMAGE=containerops-app:1.0.0
TEST_IMAGE=containerops-test:local
PROXY_IMAGE=containerops-proxy:local
HTTP_PORT=8105
TLS_PORT=8445
