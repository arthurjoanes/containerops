# Valores locais. Os scripts criam as credenciais demo.
COMPOSE_PROJECT_NAME=pf-containerops
# O runtime é calculado automaticamente a partir do perfil no Windows.
# No Linux/CI, CONTAINEROPS_RUNTIME pode apontar a uma pasta com "containerops" no nome.
APP_IMAGE=containerops-app:1.0.0
TEST_IMAGE=containerops-test:local
PROXY_IMAGE=containerops-proxy:local
DATABASE_IMAGE=containerops-database:local
HTTP_PORT=8105
TLS_PORT=8445
